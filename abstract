abstract class vehicle{
    abstract void sound();
    void sleep()
    {
        System.out.println("vehicles");
    }
}
class Bike extends vehicle{
    void sound(){
        System.out.println("Bike is riding");
    }
}
public class Main{
    public static void main(String[]args){
        Bike b=new Bike();
        b.sound();
        b.sleep();
    }
}
